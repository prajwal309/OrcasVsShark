[Unit]
Description=Orcas vs Sharks
After=network.target
RequiresMountsFor=/srv/orcas-data
AssertPathIsMountPoint=/srv/orcas-data

[Service]
Type=simple
User=orcas
Group=orcas
WorkingDirectory=/opt/orcas/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/orcas/orcas.env
UMask=0077
ExecStartPre=/usr/bin/test -w /srv/orcas-data
ExecStartPre=/usr/bin/test -s ${SQLITE_PATH}
ExecStartPre=/usr/bin/test -w ${SQLITE_PATH}
ExecStart=/usr/bin/env node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
