# Dependencies and package-manager caches (keep lockfiles tracked)
node_modules/
/.pnp
.pnp.*
.npm/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Test output and browser authentication state
/coverage/
/playwright-report/
/playwright/.cache/
/playwright/.auth/
/test-results/
/blob-report/

# next.js
/.next/
/out/

# Build output and tool caches
/build/
/dist/
.cache/
.eslintcache
.stylelintcache

# Operating system and editor artifacts
.DS_Store
._*
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
/.idea/

# Local private keys
*.pem
*.key

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment secrets; keep the documented template tracked
.env*
!.env.example

# vercel
.vercel

# Supabase CLI local state (keep migrations and config tracked)
/supabase/.temp/
/supabase/.branches/

# typescript
*.tsbuildinfo
next-env.d.ts
