# PostgreSQL 16+ connection. Use the provider's pooled PostgreSQL URL for Vercel.
PRISMA_DATABASE_URL=

# Optional direct connection for Prisma migrations and account recovery commands.
PRISMA_MIGRATION_URL=

# Exact public origin without a trailing slash. Vercel can infer one from its system variables.
APP_ORIGIN=http://localhost:3000

# Vercel uses this value to authorize the scheduled ranked-clock endpoint.
CRON_SECRET=

# Set to true to require a single-use code for password signup.
REQUIRE_SIGNUP_CODE=false

# Optional Google sign-in. Keep both values on the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Disposable PostgreSQL 16+ database for integration and online browser tests.
# TEST_POSTGRES_URL=postgresql://orcas:orcas@localhost:5432/orcas_test
