# Optional SQLite file path. Defaults to data/orcas.db relative to the app root.
# HTTPS production requires an absolute path to a prepared database on a persistent local volume.
# SQLITE_PATH=/srv/orcas-data/orcas.db

# Vercel automatically disables SQLite when its system environment variables are exposed.
# Set this manually if those variables are disabled in the Vercel project.
# ORCAS_DISABLE_SQLITE=1

# Exact HTTPS origin for remote play, with no trailing slash.
# Local HTTP accepts the actual loopback address. Google uses the exact origin.
APP_ORIGIN=http://localhost:3000

# Set to true to require a single-use code for password signup.
REQUIRE_SIGNUP_CODE=false

# Optional Google sign-in. Keep both values on the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
