# Local play needs no credentials. Online play requires all three values.
# Use a dedicated development/preview Supabase project with anonymous sign-in enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: use the Supabase transaction pooler URL on Vercel (port 6543).
# Follow Supabase's TLS connection instructions; never disable certificate verification.
DATABASE_URL=
# Never put privileged service credentials into NEXT_PUBLIC_* variables.
